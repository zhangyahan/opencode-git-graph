{
  "name": "opencode-git-graph",
  "version": "0.2.0",
  "description": "Git Graph workbench plugin for OpenCode Desktop",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist/gui-experimental.cjs",
